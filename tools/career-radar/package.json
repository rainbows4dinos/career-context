{
  "name": "career-radar-foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "functions:typecheck": "deno check --frozen --config ../../supabase/functions/job-ingest/deno.json ../../supabase/functions/job-ingest/index.ts",
    "functions:lint": "deno lint ../../supabase/functions/job-ingest/index.ts ../../supabase/functions/job-ingest/index.test.ts",
    "test:functions": "deno test --frozen --allow-read=tests/fixtures/greenhouse,tests/fixtures/ashby,tests/fixtures/lever --config ../../supabase/functions/job-ingest/deno.json ../../supabase/functions/job-ingest/index.test.ts",
    "config:generate": "node scripts/generate-public-config.js",
    "vendor:generate": "node scripts/vendor-supabase.js",
    "vendor:check": "node scripts/vendor-supabase.js --check",
    "types:generate": "node scripts/generate-database-types.js",
    "types:local-snapshot": "node scripts/generate-local-types.js",
    "db:lint": "supabase db lint --local --workdir ../.."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "entities": "8.1.0",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "deno": "2.9.6",
    "eslint": "10.12.0",
    "typescript": "7.0.2"
  }
}
