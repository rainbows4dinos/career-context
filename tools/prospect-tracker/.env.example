# Export these into your shell; the static app cannot read .env files at runtime.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Operator tooling only; not emitted into public-env.js:
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# SUPABASE_ACCESS_TOKEN and SUPABASE_DB_PASSWORD belong in secure operator tooling.
